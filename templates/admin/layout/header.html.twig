<header class="main-header">
    <div class="header-content">
        <!-- Left Section -->
        <div class="header-left">
            <!-- Mobile Menu Toggle -->
            <button class="sidebar-toggle d-lg-none" type="button">
                <i class="fas fa-bars"></i>
            </button>
            
            <!-- Page Title -->
            <div class="page-title-section">
                <h1 class="page-title">{% block page_title %}{{ 'nav.dashboard'|trans }}{% endblock %}</h1>
                {% block page_subtitle %}{% endblock %}
            </div>
        </div>
        
        <!-- Center Section -->
        <div class="header-center">
            <!-- Global Search -->
            <div class="global-search">
                <div class="search-input-group">
                    <input type="text" class="form-control" placeholder="{{ 'forms.search'|trans }}..." id="globalSearch">
                    <button class="search-btn" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Right Section -->
        <div class="header-right">
            <!-- Language Selector -->
            <div class="dropdown language-selector">
                <button class="btn btn-header dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-globe"></i>
                    <span class="d-none d-md-inline">
                        {% if app.request.locale == 'fr' %}Français{% else %}English{% endif %}
                    </span>
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" 
                           href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'en'})) }}">
                            <span class="flag-icon">🇺🇸</span> English
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item {{ app.request.locale == 'fr' ? 'active' : '' }}" 
                           href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': 'fr'})) }}">
                            <span class="flag-icon">🇫🇷</span> Français
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Notifications -->
            <div class="dropdown notifications">
                <button class="btn btn-header position-relative" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge badge bg-danger">3</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end notification-dropdown">
                    <div class="dropdown-header">
                        <h6 class="mb-0">{{ 'notifications.title'|trans }}</h6>
                        <span class="badge bg-primary">3 {{ 'notifications.new'|trans }}</span>
                    </div>
                    <div class="notification-list">
                        <a href="#" class="notification-item">
                            <div class="notification-icon bg-success">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="notification-content">
                                <div class="notification-title">Request Approved</div>
                                <div class="notification-text">Birth certificate request REQ-2024-025 has been approved</div>
                                <div class="notification-time">2 minutes ago</div>
                            </div>
                        </a>
                        <a href="#" class="notification-item">
                            <div class="notification-icon bg-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="notification-content">
                                <div class="notification-title">System Alert</div>
                                <div class="notification-text">High memory usage detected on server</div>
                                <div class="notification-time">15 minutes ago</div>
                            </div>
                        </a>
                        <a href="#" class="notification-item">
                            <div class="notification-icon bg-info">
                                <i class="fas fa-user-plus"></i>
                            </div>
                            <div class="notification-content">
                                <div class="notification-title">New User Registered</div>
                                <div class="notification-text">A new user has registered and requires approval</div>
                                <div class="notification-time">1 hour ago</div>
                            </div>
                        </a>
                    </div>
                    <div class="dropdown-footer">
                        <a href="#" class="text-center">{{ 'notifications.view_all'|trans }}</a>
                    </div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="dropdown quick-actions">
                <button class="btn btn-header" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-plus"></i>
                    <span class="d-none d-md-inline">{{ 'buttons.quick_actions'|trans }}</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ path('admin_requests_new') }}">
                        <i class="fas fa-file-plus me-2"></i>{{ 'requests.new_request'|trans }}
                    </a></li>
                    <li><a class="dropdown-item" href="{{ path('admin_users_new') }}">
                        <i class="fas fa-user-plus me-2"></i>{{ 'users.new_user'|trans }}
                    </a></li>
                    <li><a class="dropdown-item" href="{{ path('admin_documents_new') }}">
                        <i class="fas fa-upload me-2"></i>{{ 'documents.new_document'|trans }}
                    </a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="{{ path('admin_system_settings') }}">
                        <i class="fas fa-cog me-2"></i>{{ 'system.settings'|trans }}
                    </a></li>
                </ul>
            </div>
            
            <!-- User Menu -->
            <div class="dropdown user-menu">
                <button class="btn btn-header user-btn" type="button" data-bs-toggle="dropdown">
                    <div class="user-avatar">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <div class="user-info d-none d-md-block">
                        <div class="user-name">{{ app.session.get('authenticated_user').name ?? 'Administrator' }}</div>
                        <div class="user-role">{{ app.session.get('authenticated_user').role|title ?? 'Admin' }}</div>
                    </div>
                    <i class="fas fa-chevron-down"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li class="dropdown-header">
                        <div class="user-details">
                            <div class="user-name">{{ app.session.get('authenticated_user').name ?? 'Administrator' }}</div>
                            <div class="user-email">{{ app.session.get('authenticated_user').email ?? 'admin@mkgov.cm' }}</div>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#">
                        <i class="fas fa-user me-2"></i>{{ 'nav.profile'|trans }}
                    </a></li>
                    <li><a class="dropdown-item" href="#">
                        <i class="fas fa-cog me-2"></i>{{ 'user.settings'|trans }}
                    </a></li>
                    <li><a class="dropdown-item" href="#">
                        <i class="fas fa-bell me-2"></i>{{ 'user.notifications'|trans }}
                    </a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="{{ path('admin_logout') }}">
                        <i class="fas fa-sign-out-alt me-2"></i>{{ 'nav.logout'|trans }}
                    </a></li>
                </ul>
            </div>
        </div>
    </div>
    
    <!-- System Status Bar -->
    <div class="system-status-bar">
        <div class="status-indicators">
            <div class="status-indicator">
                <i class="fas fa-circle text-success"></i>
                <span>System Operational</span>
            </div>
            <div class="status-indicator">
                <i class="fas fa-users"></i>
                <span>5 Users Online</span>
            </div>
            <div class="status-indicator">
                <i class="fas fa-file-alt"></i>
                <span>12 Pending Requests</span>
            </div>
            <div class="status-indicator">
                <i class="fas fa-clock"></i>
                <span>Last Update: {{ 'now'|date('H:i') }}</span>
            </div>
        </div>
    </div>
</header>