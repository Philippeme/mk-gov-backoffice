{% extends 'admin/layout/base.html.twig' %}

{% block title %}{{ 'documents.title'|trans }} - MK Gov Backoffice{% endblock %}

{% block page_title %}{{ 'documents.title'|trans }}{% endblock %}

{% block page_subtitle %}
    <p class="text-muted mb-0">{{ 'documents.list_title'|trans }}</p>
{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">{{ 'nav.dashboard'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ 'nav.documents'|trans }}</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<div class="documents-container">
    <!-- Filters and Actions Bar -->
    <div class="filters-actions-bar mb-4">
        <div class="card">
            <div class="card-body py-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <form method="GET" class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" name="search" class="form-control" 
                                           placeholder="Search documents..." 
                                           value="{{ filters.search }}">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select name="type" class="form-select">
                                    {% for key, type in document_types %}
                                    <option value="{{ key }}" {{ filters.type == key ? 'selected' : '' }}>
                                        {{ type }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-select">
                                    {% for key, status in statuses %}
                                    <option value="{{ key }}" {{ filters.status == key ? 'selected' : '' }}>
                                        {{ status }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-filter me-1"></i>{{ 'forms.filter'|trans }}
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="{{ path('admin_documents_new') }}" class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>{{ 'documents.new_document'|trans }}
                        </a>
                        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#bulkUploadModal">
                            <i class="fas fa-upload me-2"></i>Bulk Upload
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="statistics-cards mb-4">
        <div class="row g-3">
            <div class="col-xl-2 col-md-4">
                <div class="stat-card primary">
                    <div class="stat-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ statistics.total_documents }}</div>
                        <div class="stat-label">Total Documents</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4">
                <div class="stat-card success">
                    <div class="stat-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ statistics.active_documents }}</div>
                        <div class="stat-label">Active</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4">
                <div class="stat-card warning">
                    <div class="stat-icon">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ statistics.templates_count }}</div>
                        <div class="stat-label">Templates</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4">
                <div class="stat-card info">
                    <div class="stat-icon">
                        <i class="fas fa-download"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ statistics.total_downloads }}</div>
                        <div class="stat-label">Downloads</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4">
                <div class="stat-card orange">
                    <div class="stat-icon">
                        <i class="fas fa-edit"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ statistics.draft_documents }}</div>
                        <div class="stat-label">Drafts</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4">
                <div class="stat-card gray">
                    <div class="stat-icon">
                        <i class="fas fa-hdd"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ statistics.total_size }}</div>
                        <div class="stat-label">Storage</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Documents Grid -->
    <div class="documents-grid">
        <div class="row g-4">
            {% for document in documents %}
            <div class="col-xl-4 col-md-6">
                <div class="document-card">
                    <div class="document-header">
                        <div class="document-icon">
                            {% if document.mime_type == 'application/pdf' %}
                                <i class="fas fa-file-pdf text-danger"></i>
                            {% elseif document.mime_type starts with 'image/' %}
                                <i class="fas fa-file-image text-primary"></i>
                            {% elseif document.mime_type starts with 'application/vnd.openxml' %}
                                <i class="fas fa-file-word text-info"></i>
                            {% else %}
                                <i class="fas fa-file-alt text-secondary"></i>
                            {% endif %}
                        </div>
                        <div class="document-actions">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('admin_documents_show', {id: document.id}) }}">
                                        <i class="fas fa-eye me-2"></i>View Details
                                    </a></li>
                                    <li><a class="dropdown-item" href="#">
                                        <i class="fas fa-download me-2"></i>Download
                                    </a></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_documents_edit', {id: document.id}) }}">
                                        <i class="fas fa-edit me-2"></i>Edit
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#" onclick="deleteDocument({{ document.id }})">
                                        <i class="fas fa-trash me-2"></i>Delete
                                    </a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="document-body">
                        <h6 class="document-title">{{ document.name }}</h6>
                        <div class="document-meta">
                            <div class="meta-item">
                                <span class="badge bg-{{ document.type == 'template' ? 'warning' : (document.type == 'form' ? 'info' : 'secondary') }}">
                                    {{ document.type|title }}
                                </span>
                                <span class="badge bg-outline-secondary">{{ document.category }}</span>
                            </div>
                            <div class="meta-item">
                                <small class="text-muted">
                                    <i class="fas fa-file me-1"></i>{{ (document.file_size / 1024 / 1024)|number_format(2) }} MB
                                </small>
                            </div>
                        </div>
                        
                        <div class="document-stats">
                            <div class="stat-row">
                                <div class="stat-mini">
                                    <i class="fas fa-download text-primary"></i>
                                    <span>{{ document.downloads_count }} downloads</span>
                                </div>
                            </div>
                            <div class="stat-row">
                                <div class="stat-mini">
                                    <i class="fas fa-eye text-info"></i>
                                    <span>v{{ document.version }}</span>
                                </div>
                                <div class="stat-mini">
                                    {% if document.is_public %}
                                    <i class="fas fa-globe text-success"></i>
                                    <span>Public</span>
                                    {% else %}
                                    <i class="fas fa-lock text-warning"></i>
                                    <span>Private</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="document-footer">
                        <div class="document-dates">
                            <small class="text-muted">
                                Created: {{ document.created_at|date('M d, Y') }} by {{ document.created_by }}
                            </small>
                        </div>
                        <div class="document-status">
                            <span class="badge bg-{{ document.status == 'active' ? 'success' : (document.status == 'draft' ? 'warning' : 'secondary') }}">
                                {{ document.status|title }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <div class="empty-state">
                    <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No documents found</h5>
                    <p class="text-muted">Upload your first document to get started with document management.</p>
                    <a href="{{ path('admin_documents_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Upload New Document
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Pagination -->
    {% if pagination.total_pages > 1 %}
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Documents pagination">
            <ul class="pagination">
                {% if pagination.current_page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ pagination.current_page - 1 }}">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                {% endif %}
                
                {% for page in 1..pagination.total_pages %}
                    {% if page == pagination.current_page %}
                    <li class="page-item active">
                        <span class="page-link">{{ page }}</span>
                    </li>
                    {% elseif page <= pagination.current_page + 2 and page >= pagination.current_page - 2 %}
                    <li class="page-item">
                        <a class="page-link" href="?page={{ page }}">{{ page }}</a>
                    </li>
                    {% endif %}
                {% endfor %}
                
                {% if pagination.current_page < pagination.total_pages %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ pagination.current_page + 1 }}">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
                {% endif %}
            </ul>
        </nav>
    </div>
    {% endif %}
</div>

<!-- Bulk Upload Modal -->
<div class="modal fade" id="bulkUploadModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Document Upload</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="upload-zone" id="bulkUploadZone">
                    <div class="upload-icon">
                        <i class="fas fa-cloud-upload-alt fa-3x text-muted"></i>
                    </div>
                    <div class="upload-text">
                        <h6>Drag and drop multiple files here</h6>
                        <p class="text-muted">Or click to browse and select files</p>
                        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('bulkFileInput').click()">
                            Choose Files
                        </button>
                    </div>
                    <input type="file" id="bulkFileInput" multiple accept=".pdf,.doc,.docx,.jpg,.png" style="display: none;">
                </div>
                <div id="bulkFileList" class="bulk-file-list mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="startBulkUpload" disabled>
                    <i class="fas fa-upload me-2"></i>Upload All Files
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                    <h5>Are you sure you want to delete this document?</h5>
                    <p class="text-muted">This action cannot be undone. The document file will be permanently removed.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="fas fa-trash me-2"></i>Delete Document
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block custom_javascript %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let documentToDelete = null;
    let bulkFiles = [];
    
    // Delete document function
    window.deleteDocument = function(documentId) {
        documentToDelete = documentId;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    };
    
    // Confirm delete
    document.getElementById('confirmDelete').addEventListener('click', function() {
        if (documentToDelete) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/admin/documents/${documentToDelete}/delete`;
            document.body.appendChild(form);
            form.submit();
        }
    });
    
    // Bulk upload functionality
    const bulkUploadZone = document.getElementById('bulkUploadZone');
    const bulkFileInput = document.getElementById('bulkFileInput');
    const bulkFileList = document.getElementById('bulkFileList');
    const startUploadBtn = document.getElementById('startBulkUpload');
    
    // Drag and drop handlers
    bulkUploadZone.addEventListener('dragover', handleDragOver);
    bulkUploadZone.addEventListener('drop', handleDrop);
    bulkFileInput.addEventListener('change', handleFileSelect);
    
    function handleDragOver(e) {
        e.preventDefault();
        bulkUploadZone.classList.add('drag-over');
    }
    
    function handleDrop(e) {
        e.preventDefault();
        bulkUploadZone.classList.remove('drag-over');
        const files = Array.from(e.dataTransfer.files);
        addBulkFiles(files);
    }
    
    function handleFileSelect(e) {
        const files = Array.from(e.target.files);
        addBulkFiles(files);
    }
    
    function addBulkFiles(files) {
        files.forEach(file => {
            if (validateFile(file)) {
                bulkFiles.push(file);
                displayBulkFile(file);
            }
        });
        
        startUploadBtn.disabled = bulkFiles.length === 0;
    }
    
    function validateFile(file) {
        const allowedTypes = [
            'application/pdf',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'image/jpeg',
            'image/png'
        ];
        const maxSize = 10 * 1024 * 1024; // 10MB
        
        if (!allowedTypes.includes(file.type)) {
            alert(`Invalid file type for ${file.name}. Only PDF, DOC, DOCX, JPG, and PNG files are allowed.`);
            return false;
        }
        
        if (file.size > maxSize) {
            alert(`File ${file.name} is too large. Maximum size is 10MB.`);
            return false;
        }
        
        return true;
    }
    
    function displayBulkFile(file) {
        const fileItem = document.createElement('div');
        fileItem.className = 'bulk-file-item';
        fileItem.innerHTML = `
            <div class="file-info">
                <div class="file-icon">
                    <i class="fas fa-file-${getFileIcon(file.type)}"></i>
                </div>
                <div class="file-details">
                    <div class="file-name">${file.name}</div>
                    <div class="file-size">${formatFileSize(file.size)}</div>
                </div>
            </div>
            <div class="file-actions">
                <button type="button" class="btn btn-sm btn-danger remove-bulk-file" data-file-name="${file.name}">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;
        
        bulkFileList.appendChild(fileItem);
        
        // Add remove handler
        fileItem.querySelector('.remove-bulk-file').addEventListener('click', function() {
            const fileName = this.dataset.fileName;
            bulkFiles = bulkFiles.filter(f => f.name !== fileName);
            fileItem.remove();
            startUploadBtn.disabled = bulkFiles.length === 0;
        });
    }
    
    function getFileIcon(mimeType) {
        if (mimeType === 'application/pdf') return 'pdf text-danger';
        if (mimeType.startsWith('image/')) return 'image text-primary';
        if (mimeType.includes('word')) return 'word text-info';
        return 'alt text-secondary';
    }
    
    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
    
    // Start bulk upload
    startUploadBtn.addEventListener('click', function() {
        if (bulkFiles.length === 0) return;
        
        const formData = new FormData();
        bulkFiles.forEach((file, index) => {
            formData.append(`documents[${index}]`, file);
        });
        
        // Show upload progress
        this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Uploading...';
        this.disabled = true;
        
        fetch('/admin/documents/bulk-upload', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Upload failed: ' + data.message);
                this.innerHTML = '<i class="fas fa-upload me-2"></i>Upload All Files';
                this.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred during upload.');
            this.innerHTML = '<i class="fas fa-upload me-2"></i>Upload All Files';
            this.disabled = false;
        });
    });
});
</script>

<style>
.document-card {
    background: white;
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    height: 100%;
    display: flex;
    flex-direction: column;
}

.document-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.document-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #e9ecef;
}

.document-icon {
    font-size: 2rem;
}

.document-body {
    padding: 1rem;
    flex: 1;
}

.document-title {
    margin-bottom: 0.75rem;
    color: var(--dark-color);
    font-weight: 600;
}

.document-meta {
    margin-bottom: 1rem;
}

.meta-item {
    margin-bottom: 0.5rem;
}

.document-stats {
    font-size: 0.875rem;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.25rem;
}

.stat-mini {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: #666;
}

.document-footer {
    padding: 1rem;
    border-top: 1px solid #e9ecef;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.upload-zone {
    border: 2px dashed #e9ecef;
    border-radius: var(--border-radius);
    padding: 3rem 2rem;
    text-align: center;
    background: #fafbfc;
    transition: var(--transition);
}

.upload-zone:hover,
.upload-zone.drag-over {
    border-color: var(--primary-color);
    background: rgba(26, 115, 232, 0.05);
}

.bulk-file-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid #e9ecef;
    border-radius: var(--border-radius);
    margin-bottom: 0.5rem;
    background: white;
}

.bulk-file-item .file-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.bulk-file-item .file-icon {
    font-size: 1.25rem;
}

.bulk-file-item .file-name {
    font-weight: 600;
    margin-bottom: 0.25rem;
}

.bulk-file-item .file-size {
    font-size: 0.875rem;
    color: #666;
}
</style>
{% endblock %}