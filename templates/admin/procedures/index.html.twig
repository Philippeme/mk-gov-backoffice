{% extends 'admin/layout/base.html.twig' %}

{% block title %}{{ 'procedures.title'|trans }} - MK Gov Backoffice{% endblock %}

{% block page_title %}{{ 'procedures.title'|trans }}{% endblock %}

{% block page_subtitle %}
    <p class="text-muted mb-0">{{ 'procedures.list_title'|trans }}</p>
{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">{{ 'nav.dashboard'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ 'nav.procedures'|trans }}</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<div class="procedures-container">
    <!-- Filters and Actions Bar -->
    <div class="filters-actions-bar mb-4">
        <div class="card">
            <div class="card-body py-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <form method="GET" class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" name="search" class="form-control" 
                                           placeholder="Search procedures..." 
                                           value="{{ filters.search }}">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select name="category" class="form-select">
                                    {% for key, category in categories %}
                                    <option value="{{ key }}" {{ filters.category == key ? 'selected' : '' }}>
                                        {{ category }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-select">
                                    {% for key, status in statuses %}
                                    <option value="{{ key }}" {{ filters.status == key ? 'selected' : '' }}>
                                        {{ status }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-filter me-1"></i>{{ 'forms.filter'|trans }}
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="{{ path('admin_procedures_new') }}" class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>{{ 'procedures.new_procedure'|trans }}
                        </a>
                        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#bulkActionsModal">
                            <i class="fas fa-cogs me-2"></i>Bulk Actions
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="statistics-cards mb-4">
        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <div class="stat-card primary">
                    <div class="stat-icon">
                        <i class="fas fa-project-diagram"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">{{ pagination.total_items }}</div>
                        <div class="stat-label">Total Procedures</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card success">
                    <div class="stat-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">18</div>
                        <div class="stat-label">Active Procedures</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card warning">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">5</div>
                        <div class="stat-label">Under Review</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card info">
                    <div class="stat-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">92%</div>
                        <div class="stat-label">Completion Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Procedures Grid/List -->
    <div class="procedures-grid">
        <div class="row g-4">
            {% for procedure in procedures %}
            <div class="col-xl-6">
                <div class="procedure-card">
                    <div class="procedure-header">
                        <div class="procedure-title">
                            <h5>{{ procedure.name }}</h5>
                            <span class="badge bg-{{ procedure.status == 'active' ? 'success' : (procedure.status == 'draft' ? 'secondary' : 'warning') }}">
                                {{ procedure.status|title }}
                            </span>
                        </div>
                        <div class="procedure-actions">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('admin_procedures_show', {id: procedure.id}) }}">
                                        <i class="fas fa-eye me-2"></i>View Details
                                    </a></li>
                                    <li><a class="dropdown-item" href="{{ path('admin_procedures_edit', {id: procedure.id}) }}">
                                        <i class="fas fa-edit me-2"></i>Edit
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#" onclick="deleteProcedure({{ procedure.id }})">
                                        <i class="fas fa-trash me-2"></i>Delete
                                    </a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="procedure-body">
                        <div class="procedure-meta">
                            <div class="meta-item">
                                <i class="fas fa-layer-group text-primary"></i>
                                <span>{{ procedure.category }}</span>
                            </div>
                            <div class="meta-item">
                                <i class="fas fa-clock text-warning"></i>
                                <span>{{ procedure.processing_time }}</span>
                            </div>
                            <div class="meta-item">
                                <i class="fas fa-money-bill text-success"></i>
                                <span>{{ procedure.cost|number_format }} {{ procedure.currency }}</span>
                            </div>
                        </div>
                        
                        <div class="procedure-stats">
                            <div class="row g-3">
                                <div class="col-4">
                                    <div class="stat-mini">
                                        <div class="stat-mini-value">{{ procedure.total_requests }}</div>
                                        <div class="stat-mini-label">Requests</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-mini">
                                        <div class="stat-mini-value">{{ procedure.completion_rate }}%</div>
                                        <div class="stat-mini-label">Success</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-mini">
                                        <div class="stat-mini-value">{{ procedure.responsible_entity|slice(0, 10) }}...</div>
                                        <div class="stat-mini-label">Entity</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="procedure-footer">
                        <div class="procedure-dates">
                            <small class="text-muted">
                                Created: {{ procedure.created_at|date('M d, Y') }} • 
                                Updated: {{ procedure.updated_at|date('M d, Y') }}
                            </small>
                        </div>
                        <div class="procedure-cta">
                            <a href="{{ path('admin_procedures_show', {id: procedure.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-arrow-right me-1"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <div class="empty-state">
                    <i class="fas fa-project-diagram fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No procedures found</h5>
                    <p class="text-muted">Create your first procedure to get started with service management.</p>
                    <a href="{{ path('admin_procedures_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create New Procedure
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Pagination -->
    {% if pagination.total_pages > 1 %}
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Procedures pagination">
            <ul class="pagination">
                {% if pagination.current_page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ pagination.current_page - 1 }}">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                {% endif %}
                
                {% for page in 1..pagination.total_pages %}
                    {% if page == pagination.current_page %}
                    <li class="page-item active">
                        <span class="page-link">{{ page }}</span>
                    </li>
                    {% elseif page <= pagination.current_page + 2 and page >= pagination.current_page - 2 %}
                    <li class="page-item">
                        <a class="page-link" href="?page={{ page }}">{{ page }}</a>
                    </li>
                    {% endif %}
                {% endfor %}
                
                {% if pagination.current_page < pagination.total_pages %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ pagination.current_page + 1 }}">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
                {% endif %}
            </ul>
        </nav>
    </div>
    {% endif %}
</div>

<!-- Bulk Actions Modal -->
<div class="modal fade" id="bulkActionsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Actions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Select Action</label>
                    <select class="form-select" id="bulkAction">
                        <option value="">Choose action...</option>
                        <option value="activate">Activate Selected</option>
                        <option value="deactivate">Deactivate Selected</option>
                        <option value="delete">Delete Selected</option>
                    </select>
                </div>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Please select procedures first by checking the boxes in the list.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="executeBulkAction">
                    Execute Action
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                    <h5>Are you sure you want to delete this procedure?</h5>
                    <p class="text-muted">This action cannot be undone. All associated data will be permanently removed.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="fas fa-trash me-2"></i>Delete Procedure
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block custom_javascript %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let procedureToDelete = null;
    
    // Delete procedure function
    window.deleteProcedure = function(procedureId) {
        procedureToDelete = procedureId;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    };
    
    // Confirm delete
    document.getElementById('confirmDelete').addEventListener('click', function() {
        if (procedureToDelete) {
            // Create a form and submit it
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/admin/procedures/${procedureToDelete}/delete`;
            document.body.appendChild(form);
            form.submit();
        }
    });
    
    // Bulk actions
    document.getElementById('executeBulkAction').addEventListener('click', function() {
        const action = document.getElementById('bulkAction').value;
        if (!action) {
            alert('Please select an action first.');
            return;
        }
        
        // Get selected procedures (would need checkboxes in the actual implementation)
        const selectedProcedures = [];
        
        if (selectedProcedures.length === 0) {
            alert('Please select procedures first.');
            return;
        }
        
        // Execute bulk action
        console.log('Executing bulk action:', action, 'on procedures:', selectedProcedures);
    });
    
    // Auto-refresh statistics every 30 seconds
    setInterval(function() {
        // Update statistics here
        console.log('Refreshing procedure statistics...');
    }, 30000);
});
</script>
{% endblock %}