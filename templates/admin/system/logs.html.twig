{% extends 'admin/layout/base.html.twig' %}

{% block title %}{{ 'system.logs'|trans }} - MK Gov Backoffice{% endblock %}

{% block page_title %}{{ 'system.logs'|trans }}{% endblock %}

{% block page_subtitle %}
    <p class="text-muted mb-0">Monitor system activities and troubleshoot issues</p>
{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">{{ 'nav.dashboard'|trans }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_system_settings') }}">{{ 'nav.system'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ 'system.logs'|trans }}</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<div class="system-logs-container">
    <!-- System Health Overview -->
    <div class="health-overview mb-4">
        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <div class="health-card {{ system_health.overall_status == 'healthy' ? 'healthy' : 'warning' }}">
                    <div class="health-icon">
                        <i class="fas fa-{{ system_health.overall_status == 'healthy' ? 'check-circle' : 'exclamation-triangle' }}"></i>
                    </div>
                    <div class="health-content">
                        <div class="health-status">{{ system_health.overall_status|title }}</div>
                        <div class="health-label">System Status</div>
                    </div>
                    <div class="health-indicator bg-{{ system_health.overall_status == 'healthy' ? 'success' : 'warning' }}"></div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="health-card">
                    <div class="health-icon">
                        <i class="fas fa-microchip"></i>
                    </div>
                    <div class="health-content">
                        <div class="health-status">{{ system_health.cpu_usage }}%</div>
                        <div class="health-label">CPU Usage</div>
                    </div>
                    <div class="health-progress">
                        <div class="progress-bar bg-{{ system_health.cpu_usage > 80 ? 'danger' : (system_health.cpu_usage > 60 ? 'warning' : 'success') }}" 
                             style="width: {{ system_health.cpu_usage }}%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="health-card">
                    <div class="health-icon">
                        <i class="fas fa-memory"></i>
                    </div>
                    <div class="health-content">
                        <div class="health-status">{{ system_health.memory_usage }}%</div>
                        <div class="health-label">Memory Usage</div>
                    </div>
                    <div class="health-progress">
                        <div class="progress-bar bg-{{ system_health.memory_usage > 80 ? 'danger' : (system_health.memory_usage > 60 ? 'warning' : 'success') }}" 
                             style="width: {{ system_health.memory_usage }}%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="health-card">
                    <div class="health-icon">
                        <i class="fas fa-hdd"></i>
                    </div>
                    <div class="health-content">
                        <div class="health-status">{{ system_health.disk_usage }}%</div>
                        <div class="health-label">Disk Usage</div>
                    </div>
                    <div class="health-progress">
                        <div class="progress-bar bg-{{ system_health.disk_usage > 80 ? 'danger' : (system_health.disk_usage > 60 ? 'warning' : 'success') }}" 
                             style="width: {{ system_health.disk_usage }}%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Actions -->
    <div class="filters-actions-bar mb-4">
        <div class="card">
            <div class="card-body py-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <form method="GET" class="row g-3 align-items-center">
                            <div class="col-md-3">
                                <select name="level" class="form-select">
                                    {% for key, level in log_levels %}
                                    <option value="{{ key }}" {{ filters.level == key ? 'selected' : '' }}>
                                        {{ level }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="category" class="form-select">
                                    {% for key, category in log_categories %}
                                    <option value="{{ key }}" {{ filters.category == key ? 'selected' : '' }}>
                                        {{ category }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="date_from" class="form-control" value="{{ filters.date_from }}">
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="date_to" class="form-control" value="{{ filters.date_to }}">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-filter"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-end">
                        <button class="btn btn-outline-success" onclick="refreshLogs()">
                            <i class="fas fa-sync-alt me-2"></i>Refresh
                        </button>
                        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exportLogsModal">
                            <i class="fas fa-download me-2"></i>Export
                        </button>
                        <button class="btn btn-outline-danger" onclick="clearLogs()">
                            <i class="fas fa-trash me-2"></i>Clear Logs
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>System Logs
            </h5>
            <div class="card-tools">
                <div class="btn-group btn-group-sm" role="group">
                    <input type="radio" class="btn-check" name="logView" id="tableView" checked>
                    <label class="btn btn-outline-secondary" for="tableView">
                        <i class="fas fa-table"></i> Table
                    </label>
                    <input type="radio" class="btn-check" name="logView" id="rawView">
                    <label class="btn btn-outline-secondary" for="rawView">
                        <i class="fas fa-code"></i> Raw
                    </label>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <!-- Table View -->
            <div id="tableViewContent">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th width="120">Timestamp</th>
                                <th width="80">Level</th>
                                <th width="120">Category</th>
                                <th>Message</th>
                                <th width="100">Source</th>
                                <th width="60">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                            <tr class="log-row log-{{ log.level }}" data-log-id="{{ log.id }}">
                                <td>
                                    <div class="log-timestamp">
                                        <div>{{ log.timestamp|date('M d, H:i:s') }}</div>
                                        <small class="text-muted">{{ log.timestamp|date('Y') }}</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-{{ log.level == 'error' ? 'danger' : (log.level == 'warning' ? 'warning' : (log.level == 'info' ? 'info' : 'secondary')) }}">
                                        {{ log.level|upper }}
                                    </span>
                                </td>
                                <td>
                                    <span class="log-category">{{ log.category|title }}</span>
                                </td>
                                <td>
                                    <div class="log-message">
                                        <div class="message-text">{{ log.message }}</div>
                                        {% if log.context %}
                                        <button class="btn btn-sm btn-link p-0" data-bs-toggle="collapse" 
                                                data-bs-target="#context-{{ log.id }}">
                                            <i class="fas fa-chevron-down"></i> Context
                                        </button>
                                        {% endif %}
                                    </div>
                                    {% if log.context %}
                                    <div class="collapse" id="context-{{ log.id }}">
                                        <div class="log-context">
                                            <pre><code>{{ log.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                                        </div>
                                    </div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="log-source">{{ log.source }}</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" onclick="viewLogDetails({{ log.id }})" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="empty-state">
                                        <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                                        <h5 class="text-muted">No logs found</h5>
                                        <p class="text-muted">Try adjusting your filters or check back later.</p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Raw View -->
            <div id="rawViewContent" style="display: none;">
                <div class="raw-logs">
                    <pre><code id="rawLogsContent">Loading raw logs...</code></pre>
                </div>
            </div>
        </div>
        
        <!-- Pagination -->
        {% if pagination.total_pages > 1 %}
        <div class="card-footer">
            <nav aria-label="Logs pagination">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    {% if pagination.current_page > 1 %}
                    <li class="page-item">
                        <a class="page-link" href="?page={{ pagination.current_page - 1 }}">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    {% endif %}
                    
                    {% for page in 1..pagination.total_pages %}
                        {% if page == pagination.current_page %}
                        <li class="page-item active">
                            <span class="page-link">{{ page }}</span>
                        </li>
                        {% elseif page <= pagination.current_page + 2 and page >= pagination.current_page - 2 %}
                        <li class="page-item">
                            <a class="page-link" href="?page={{ page }}">{{ page }}</a>
                        </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if pagination.current_page < pagination.total_pages %}
                    <li class="page-item">
                        <a class="page-link" href="?page={{ pagination.current_page + 1 }}">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
        {% endif %}
    </div>
</div>

<!-- Export Logs Modal -->
<div class="modal fade" id="exportLogsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Export System Logs</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Export Format</label>
                    <select class="form-select" id="exportFormat">
                        <option value="csv">CSV</option>
                        <option value="json">JSON</option>
                        <option value="txt">Plain Text</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Date Range</label>
                    <div class="row">
                        <div class="col-6">
                            <input type="date" class="form-control" id="exportDateFrom">
                        </div>
                        <div class="col-6">
                            <input type="date" class="form-control" id="exportDateTo">
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Log Level</label>
                    <select class="form-select" id="exportLevel">
                        <option value="all">All Levels</option>
                        <option value="error">Errors Only</option>
                        <option value="warning">Warnings and Above</option>
                        <option value="info">Info and Above</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="exportLogs()">
                    <i class="fas fa-download me-2"></i>Export
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Log Entry Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="logDetailsContent">
                    <!-- Log details will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block custom_javascript %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-refresh logs every 30 seconds
    let autoRefreshInterval;
    
    function startAutoRefresh() {
        autoRefreshInterval = setInterval(refreshLogs, 30000);
    }
    
    function stopAutoRefresh() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
        }
    }
    
    startAutoRefresh();
    
    // View mode toggle
    const tableView = document.getElementById('tableView');
    const rawView = document.getElementById('rawView');
    const tableViewContent = document.getElementById('tableViewContent');
    const rawViewContent = document.getElementById('rawViewContent');
    
    rawView.addEventListener('change', function() {
        if (this.checked) {
            tableViewContent.style.display = 'none';
            rawViewContent.style.display = 'block';
            loadRawLogs();
        }
    });
    
    tableView.addEventListener('change', function() {
        if (this.checked) {
            rawViewContent.style.display = 'none';
            tableViewContent.style.display = 'block';
        }
    });
    
    // Functions
    window.refreshLogs = function() {
        const refreshBtn = event.target.closest('button');
        const originalHTML = refreshBtn.innerHTML;
        refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Refreshing...';
        refreshBtn.disabled = true;
        
        fetch(window.location.href, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            // Update the logs table
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newTable = doc.querySelector('table');
            if (newTable) {
                document.querySelector('table').replaceWith(newTable);
            }
            showNotification('Logs refreshed successfully', 'success');
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('Failed to refresh logs', 'error');
        })
        .finally(() => {
            refreshBtn.innerHTML = originalHTML;
            refreshBtn.disabled = false;
        });
    };
    
    window.clearLogs = function() {
        if (confirm('Are you sure you want to clear all system logs? This action cannot be undone.')) {
            fetch('/admin/system/clear-logs', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    showNotification('Failed to clear logs: ' + data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('An error occurred while clearing logs', 'error');
            });
        }
    };
    
    window.viewLogDetails = function(logId) {
        fetch(`/admin/system/logs/${logId}`)
        .then(response => response.json())
        .then(data => {
            const content = document.getElementById('logDetailsContent');
            content.innerHTML = `
                <div class="log-detail">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label>Timestamp:</label>
                                <div>${data.timestamp}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label>Level:</label>
                                <div><span class="badge bg-${getLevelColor(data.level)}">${data.level.toUpperCase()}</span></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label>Category:</label>
                                <div>${data.category}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label>Source:</label>
                                <div>${data.source}</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="detail-item">
                                <label>Message:</label>
                                <div class="message-detail">${data.message}</div>
                            </div>
                        </div>
                        ${data.context ? `
                        <div class="col-12">
                            <div class="detail-item">
                                <label>Context:</label>
                                <div class="context-detail">
                                    <pre><code>${JSON.stringify(data.context, null, 2)}</code></pre>
                                </div>
                            </div>
                        </div>
                        ` : ''}
                    </div>
                </div>
            `;
            
            new bootstrap.Modal(document.getElementById('logDetailsModal')).show();
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('Failed to load log details', 'error');
        });
    };
    
    window.exportLogs = function() {
        const format = document.getElementById('exportFormat').value;
        const dateFrom = document.getElementById('exportDateFrom').value;
        const dateTo = document.getElementById('exportDateTo').value;
        const level = document.getElementById('exportLevel').value;
        
        const params = new URLSearchParams({
            format: format,
            date_from: dateFrom,
            date_to: dateTo,
            level: level
        });
        
        window.open(`/admin/system/export-logs?${params.toString()}`);
        bootstrap.Modal.getInstance(document.getElementById('exportLogsModal')).hide();
    };
    
    function loadRawLogs() {
        const rawContent = document.getElementById('rawLogsContent');
        rawContent.textContent = 'Loading raw logs...';
        
        fetch('/admin/system/raw-logs')
        .then(response => response.text())
        .then(data => {
            rawContent.textContent = data;
        })
        .catch(error => {
            rawContent.textContent = 'Error loading raw logs: ' + error.message;
        });
    }
    
    function getLevelColor(level) {
        const colors = {
            'error': 'danger',
            'warning': 'warning',
            'info': 'info',
            'debug': 'secondary'
        };
        return colors[level] || 'secondary';
    }
    
    function showNotification(message, type) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(alertDiv);
        
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }
    
    // Stop auto-refresh when page is hidden
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            stopAutoRefresh();
        } else {
            startAutoRefresh();
        }
    });
});
</script>

<style>
.health-overview {
    margin-bottom: 2rem;
}

.health-card {
    background: white;
    border-radius: var(--border-radius);
    padding: 1.5rem;
    box-shadow: var(--box-shadow);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.health-card.healthy {
    border-left: 4px solid var(--success-color);
}

.health-card.warning {
    border-left: 4px solid var(--warning-color);
}

.health-icon {
    font-size: 2rem;
    color: var(--primary-color);
}

.health-content {
    flex: 1;
}

.health-status {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dark-color);
    margin-bottom: 0.25rem;
}

.health-label {
    font-size: 0.875rem;
    color: #666;
    font-weight: 500;
}

.health-progress {
    width: 40px;
    height: 4px;
    background: #e9ecef;
    border-radius: 2px;
    overflow: hidden;
}

.health-progress .progress-bar {
    height: 100%;
    transition: width 0.3s ease;
}

.health-indicator {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
}

.log-row:hover {
    background-color: rgba(26, 115, 232, 0.05);
}

.log-timestamp {
    font-size: 0.875rem;
}

.log-category {
    font-weight: 500;
}

.log-message {
    max-width: 400px;
}

.message-text {
    margin-bottom: 0.5rem;
    word-break: break-word;
}

.log-context {
    background: #f8f9fa;
    border-radius: var(--border-radius);
    padding: 0.75rem;
    margin-top: 0.5rem;
    max-height: 200px;
    overflow-y: auto;
}

.log-context pre {
    margin: 0;
    font-size: 0.75rem;
}

.log-source {
    font-size: 0.875rem;
    color: #666;
}

.raw-logs {
    padding: 1rem;
    background: #1e1e1e;
    color: #d4d4d4;
    border-radius: var(--border-radius);
    max-height: 600px;
    overflow-y: auto;
}

.raw-logs pre {
    margin: 0;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    line-height: 1.4;
}

.detail-item {
    margin-bottom: 1rem;
}

.detail-item label {
    font-weight: 600;
    color: var(--dark-color);
    display: block;
    margin-bottom: 0.25rem;
}

.message-detail {
    background: #f8f9fa;
    padding: 0.75rem;
    border-radius: var(--border-radius);
    border-left: 4px solid var(--primary-color);
}

.context-detail {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 0.75rem;
    border-radius: var(--border-radius);
    max-height: 300px;
    overflow-y: auto;
}

.context-detail pre {
    margin: 0;
    font-size: 0.875rem;
}

.log-error {
    border-left: 3px solid var(--danger-color);
}

.log-warning {
    border-left: 3px solid var(--warning-color);
}

.log-info {
    border-left: 3px solid var(--info-color);
}

.log-debug {
    border-left: 3px solid #6c757d;
}
</style>
{% endblock %}