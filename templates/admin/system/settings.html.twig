{% extends 'admin/layout/base.html.twig' %}

{% block title %}{{ 'system.settings'|trans }} - MK Gov Backoffice{% endblock %}

{% block page_title %}{{ 'system.settings'|trans }}{% endblock %}

{% block page_subtitle %}
    <p class="text-muted mb-0">Configure system-wide settings and preferences</p>
{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">{{ 'nav.dashboard'|trans }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_system_settings') }}">{{ 'nav.system'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ 'system.settings'|trans }}</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<div class="system-settings-container">
    <form method="POST" id="systemSettingsForm">
        <div class="row g-4">
            <!-- Settings Tabs -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <ul class="nav nav-tabs card-header-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" href="#application" role="tab">
                                    <i class="fas fa-cog me-2"></i>Application
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#email" role="tab">
                                    <i class="fas fa-envelope me-2"></i>Email
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#security" role="tab">
                                    <i class="fas fa-shield-alt me-2"></i>Security
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#notifications" role="tab">
                                    <i class="fas fa-bell me-2"></i>Notifications
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#integration" role="tab">
                                    <i class="fas fa-link me-2"></i>Integration
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <!-- Application Settings -->
                            <div class="tab-pane fade show active" id="application" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Basic Configuration</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Application Name</label>
                                                <input type="text" class="form-control" name="app_name" 
                                                       value="{{ settings.application.name }}" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Version</label>
                                                <input type="text" class="form-control" name="app_version" 
                                                       value="{{ settings.application.version }}" readonly>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Environment</label>
                                                <select class="form-select" name="app_environment">
                                                    <option value="development" {{ settings.application.environment == 'development' ? 'selected' : '' }}>Development</option>
                                                    <option value="staging" {{ settings.application.environment == 'staging' ? 'selected' : '' }}>Staging</option>
                                                    <option value="production" {{ settings.application.environment == 'production' ? 'selected' : '' }}>Production</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="debug_mode" 
                                                           {{ settings.application.debug_mode ? 'checked' : '' }}>
                                                    <label class="form-check-label">Debug Mode</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="maintenance_mode" 
                                                           {{ settings.application.maintenance_mode ? 'checked' : '' }}>
                                                    <label class="form-check-label">Maintenance Mode</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Localization</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Default Language</label>
                                                <select class="form-select" name="default_language">
                                                    <option value="en" {{ settings.application.default_language == 'en' ? 'selected' : '' }}>English</option>
                                                    <option value="fr" {{ settings.application.default_language == 'fr' ? 'selected' : '' }}>Français</option>
                                                    <option value="pt" {{ settings.application.default_language == 'pt' ? 'selected' : '' }}>Português</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Timezone</label>
                                                <select class="form-select" name="timezone">
                                                    <option value="Africa/Douala" {{ settings.application.timezone == 'Africa/Douala' ? 'selected' : '' }}>Africa/Douala</option>
                                                    <option value="Africa/Bissau" {{ settings.application.timezone == 'Africa/Bissau' ? 'selected' : '' }}>Africa/Bissau</option>
                                                    <option value="UTC" {{ settings.application.timezone == 'UTC' ? 'selected' : '' }}>UTC</option>
                                                </select>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">System Status</h6>
                                            <div class="system-status-indicators">
                                                <div class="status-item">
                                                    <div class="status-indicator bg-success"></div>
                                                    <span>Database Connected</span>
                                                </div>
                                                <div class="status-item">
                                                    <div class="status-indicator bg-success"></div>
                                                    <span>Cache Operational</span>
                                                </div>
                                                <div class="status-item">
                                                    <div class="status-indicator bg-warning"></div>
                                                    <span>Email Service</span>
                                                </div>
                                                <div class="status-item">
                                                    <div class="status-indicator bg-success"></div>
                                                    <span>File Storage</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Email Settings -->
                            <div class="tab-pane fade" id="email" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">SMTP Configuration</h6>
                                            <div class="mb-3">
                                                <label class="form-label">SMTP Host</label>
                                                <input type="text" class="form-control" name="smtp_host" 
                                                       value="{{ settings.email.smtp_host }}">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">SMTP Port</label>
                                                <input type="number" class="form-control" name="smtp_port" 
                                                       value="{{ settings.email.smtp_port }}">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Username</label>
                                                <input type="text" class="form-control" name="smtp_username" 
                                                       value="{{ settings.email.smtp_username }}">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Password</label>
                                                <input type="password" class="form-control" name="smtp_password" 
                                                       placeholder="••••••••">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Encryption</label>
                                                <select class="form-select" name="smtp_encryption">
                                                    <option value="none">None</option>
                                                    <option value="tls" {{ settings.email.smtp_encryption == 'tls' ? 'selected' : '' }}>TLS</option>
                                                    <option value="ssl" {{ settings.email.smtp_encryption == 'ssl' ? 'selected' : '' }}>SSL</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Email Defaults</h6>
                                            <div class="mb-3">
                                                <label class="form-label">From Email</label>
                                                <input type="email" class="form-control" name="from_email" 
                                                       value="{{ settings.email.from_email }}">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">From Name</label>
                                                <input type="text" class="form-control" name="from_name" 
                                                       value="{{ settings.email.from_name }}">
                                            </div>
                                        </div>
                                        
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Test Email</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Test Email Address</label>
                                                <div class="input-group">
                                                    <input type="email" class="form-control" id="testEmailAddress" 
                                                           placeholder="test@example.com">
                                                    <button class="btn btn-outline-primary" type="button" onclick="sendTestEmail()">
                                                        <i class="fas fa-paper-plane"></i> Send Test
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Security Settings -->
                            <div class="tab-pane fade" id="security" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Session Security</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Session Timeout (seconds)</label>
                                                <input type="number" class="form-control" name="session_timeout" 
                                                       value="{{ settings.security.session_timeout }}">
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="two_factor_auth" 
                                                           {{ settings.security.two_factor_auth ? 'checked' : '' }}>
                                                    <label class="form-check-label">Two-Factor Authentication</label>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Login Security</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Login Attempts Limit</label>
                                                <input type="number" class="form-control" name="login_attempts_limit" 
                                                       value="{{ settings.security.login_attempts_limit }}">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Account Lockout Duration (seconds)</label>
                                                <input type="number" class="form-control" name="account_lockout_duration" 
                                                       value="{{ settings.security.account_lockout_duration }}">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Password Policy</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Minimum Password Length</label>
                                                <input type="number" class="form-control" name="password_min_length" 
                                                       value="{{ settings.security.password_min_length }}">
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="password_complexity" 
                                                           {{ settings.security.password_complexity ? 'checked' : '' }}>
                                                    <label class="form-check-label">Require Complex Passwords</label>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Security Monitoring</h6>
                                            <div class="security-alerts">
                                                <div class="alert alert-success">
                                                    <i class="fas fa-check-circle me-2"></i>
                                                    No security incidents in the last 24 hours
                                                </div>
                                                <div class="alert alert-info">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    15 successful logins today
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Notifications Settings -->
                            <div class="tab-pane fade" id="notifications" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Email Notifications</h6>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="email_notifications" 
                                                           {{ settings.notifications.email_notifications ? 'checked' : '' }}>
                                                    <label class="form-check-label">Enable Email Notifications</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="request_status_updates" 
                                                           {{ settings.notifications.request_status_updates ? 'checked' : '' }}>
                                                    <label class="form-check-label">Request Status Updates</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="system_alerts" 
                                                           {{ settings.notifications.system_alerts ? 'checked' : '' }}>
                                                    <label class="form-check-label">System Alerts</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="daily_reports" 
                                                           {{ settings.notifications.daily_reports ? 'checked' : '' }}>
                                                    <label class="form-check-label">Daily Reports</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">SMS Notifications</h6>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="sms_notifications" 
                                                           {{ settings.notifications.sms_notifications ? 'checked' : '' }}>
                                                    <label class="form-check-label">Enable SMS Notifications</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Integration Settings -->
                            <div class="tab-pane fade" id="integration" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">Frontend Integration</h6>
                                            <div class="mb-3">
                                                <label class="form-label">Angular Frontend URL</label>
                                                <input type="url" class="form-control" name="angular_frontend_url" 
                                                       value="{{ settings.integration.angular_frontend_url }}">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">API Rate Limit (requests/hour)</label>
                                                <input type="number" class="form-control" name="api_rate_limit" 
                                                       value="{{ settings.integration.api_rate_limit }}">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="setting-group">
                                            <h6 class="setting-group-title">External Services</h6>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="external_apis_enabled" 
                                                           {{ settings.integration.external_apis_enabled ? 'checked' : '' }}>
                                                    <label class="form-check-label">Enable External APIs</label>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="payment_gateway_enabled" 
                                                           {{ settings.integration.payment_gateway_enabled ? 'checked' : '' }}>
                                                    <label class="form-check-label">Enable Payment Gateway</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Information -->
            <div class="col-12">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-server me-2"></i>Server Information
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="info-list">
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">PHP Version:</span>
                                        <span class="info-value-sm">{{ system_info.server.php_version }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Symfony Version:</span>
                                        <span class="info-value-sm">{{ system_info.server.symfony_version }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Server Software:</span>
                                        <span class="info-value-sm">{{ system_info.server.server_software }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Memory Limit:</span>
                                        <span class="info-value-sm">{{ system_info.server.memory_limit }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-database me-2"></i>Database Information
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="info-list">
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Type:</span>
                                        <span class="info-value-sm">{{ system_info.database.type }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Version:</span>
                                        <span class="info-value-sm">{{ system_info.database.version }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Database Size:</span>
                                        <span class="info-value-sm">{{ system_info.database.size }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Tables:</span>
                                        <span class="info-value-sm">{{ system_info.database.tables_count }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-hdd me-2"></i>Storage Information
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="info-list">
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Uploads Size:</span>
                                        <span class="info-value-sm">{{ system_info.storage.uploads_size }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Logs Size:</span>
                                        <span class="info-value-sm">{{ system_info.storage.logs_size }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Uploads Path:</span>
                                        <span class="info-value-sm">{{ system_info.storage.uploads_path }}</span>
                                    </div>
                                    <div class="info-item-sm">
                                        <span class="info-label-sm">Logs Path:</span>
                                        <span class="info-value-sm">{{ system_info.storage.logs_path }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between">
                    <div>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetToDefaults()">
                            <i class="fas fa-undo me-2"></i>Reset to Defaults
                        </button>
                        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#backupModal">
                            <i class="fas fa-download me-2"></i>Create Backup
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary" onclick="history.back()">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Settings
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Backup Modal -->
<div class="modal fade" id="backupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create System Backup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Backup Type</label>
                    <select class="form-select" id="backupType">
                        <option value="full">Full System Backup</option>
                        <option value="settings">Settings Only</option>
                        <option value="database">Database Only</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Backup Description</label>
                    <textarea class="form-control" id="backupDescription" rows="3" 
                              placeholder="Optional description for this backup..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createBackup()">
                    <i class="fas fa-download me-2"></i>Create Backup
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block custom_javascript %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Form submission handler
    document.getElementById('systemSettingsForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
        submitBtn.disabled = true;
        
        fetch(window.location.href, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showAlert('Settings saved successfully!', 'success');
            } else {
                showAlert('Error saving settings: ' + data.message, 'danger');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlert('An error occurred while saving settings.', 'danger');
        })
        .finally(() => {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        });
    });
    
    // Test email function
    window.sendTestEmail = function() {
        const emailAddress = document.getElementById('testEmailAddress').value;
        
        if (!emailAddress) {
            alert('Please enter an email address.');
            return;
        }
        
        const btn = event.target;
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
        btn.disabled = true;
        
        fetch('/admin/system/test-email', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email: emailAddress })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showAlert('Test email sent successfully!', 'success');
            } else {
                showAlert('Failed to send test email: ' + data.message, 'danger');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlert('An error occurred while sending test email.', 'danger');
        })
        .finally(() => {
            btn.innerHTML = originalHTML;
            btn.disabled = false;
        });
    };
    
    // Reset to defaults
    window.resetToDefaults = function() {
        if (confirm('Are you sure you want to reset all settings to their default values? This action cannot be undone.')) {
            fetch('/admin/system/reset-defaults', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    showAlert('Error resetting settings: ' + data.message, 'danger');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('An error occurred while resetting settings.', 'danger');
            });
        }
    };
    
    // Create backup
    window.createBackup = function() {
        const backupType = document.getElementById('backupType').value;
        const description = document.getElementById('backupDescription').value;
        
        const btn = event.target;
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Creating...';
        btn.disabled = true;
        
        fetch('/admin/system/backup', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                type: backupType,
                description: description
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showAlert('Backup created successfully!', 'success');
                bootstrap.Modal.getInstance(document.getElementById('backupModal')).hide();
            } else {
                showAlert('Error creating backup: ' + data.message, 'danger');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlert('An error occurred while creating backup.', 'danger');
        })
        .finally(() => {
            btn.innerHTML = originalHTML;
            btn.disabled = false;
        });
    };
    
    function showAlert(message, type) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        const container = document.querySelector('.system-settings-container');
        container.insertBefore(alertDiv, container.firstChild);
        
        // Auto-dismiss after 5 seconds
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }
});
</script>

